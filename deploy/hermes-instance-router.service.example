[Unit]
Description=Hermes Instance Router
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/hermes-router/app
# Duplicate this unit per environment and point each copy to a different env file.
EnvironmentFile=/data/hermes-router/hermes-instance-router.env
ExecStart=/usr/local/bin/node /data/hermes-router/app/server-router.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
