# Duplicate this env per environment on the instance host, for example:
# - /data/hermes-router/hermes-instance-router-prod.env
# - /data/hermes-router/hermes-instance-router-dev.env
HERMES_ROUTER_HOST=0.0.0.0
HERMES_ROUTER_PORT=19080
HERMES_ROUTER_ROUTES_DIR=/data/hermes/router/routes
HERMES_ROUTER_SHARED_TOKEN=replace-with-a-long-random-internal-token
