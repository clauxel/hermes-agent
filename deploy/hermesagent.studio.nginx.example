server {
    listen 80;
    server_name www.hermesagent.studio hermesagent.studio;
    return 301 https://hermesagent.studio$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.hermesagent.studio;

    ssl_certificate /etc/letsencrypt/live/hermesagent.studio/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hermesagent.studio/privkey.pem;

    return 301 https://hermesagent.studio$request_uri;
}

server {
    listen 443 ssl http2;
    server_name hermesagent.studio;

    ssl_certificate /etc/letsencrypt/live/hermesagent.studio/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hermesagent.studio/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
