# Same-host production topology:
# Nginx -> npm run start -> same-origin frontend, API, and console proxy
# Keep VITE_API_BASE_URL unset in the frontend build for this mode.
NODE_ENV=production
PORT=5173
APP_ORIGIN=https://www.aigeamy.com,https://aigeamy.com
HERMES_DATA_DIR=/data/hermes-agent/data
HERMES_CONFIG_PATH=/data/hermes-agent/hermes-agent.config.json
HERMES_TOKEN_SECRET=replace-with-a-long-random-token-secret
HERMES_CONFIG_SECRET=replace-with-a-long-random-config-secret
HERMES_LAUNCH_DEPLOY_HOST=1.2.3.4
HERMES_LAUNCH_DEPLOY_PORT=22
HERMES_LAUNCH_DEPLOY_USERNAME=root
HERMES_LAUNCH_DEPLOY_ROOT_PASSWORD=replace-with-root-password
HERMES_DEPLOY_HOST=1.2.3.4
HERMES_DEPLOY_PORT=22
HERMES_DEPLOY_USERNAME=root
HERMES_DEPLOY_ROOT_PASSWORD=replace-with-root-password
# Optional fixed instance router on the Hermes instance host.
# Recommended production layout on 116:
# - prod router: http://10.128.0.4:19080 -> /data/hermes/router/routes-prod
# - dev router:  http://34.71.182.116:19081 -> /data/hermes/router/routes-dev
# When set, console URLs become ${HERMES_ROUTER_BASE_URL}/instances/<instanceName>/
HERMES_ROUTER_BASE_URL=http://10.128.0.4:19080
HERMES_ROUTER_ROUTES_DIR=/data/hermes/router/routes-prod
HERMES_ROUTER_SHARED_TOKEN=replace-with-prod-router-shared-token
HERMES_MODEL_PROXY_BASE_URL=https://thousandengine.com
HERMES_MODEL_PROXY_INTERNAL_BASE_URL=http://10.128.0.2:5173/api/internal/model-proxy
HERMES_MODEL_PROXY_ALLOWED_REMOTE_ADDRESSES=10.128.0.4
HERMES_MODEL_PROXY_MODEL_MAP_JSON={"gemini-3-1-pro":"gemini-3.1-pro-preview","gpt-5-4":"gpt-5.4","claude-opus-4-6":"claude-opus-4-6","glm-4-7":"glm-4.7","glm-5-1":"glm-5","gemini-3-pro":"gemini-3-pro-preview","gpt-4-1":"gpt-4.1"}
HERMES_MODEL_PROXY_CHAT_MAX_TOKENS_CAP=1024
QS_KEY=replace-with-model-proxy-api-key
PAYMENT_PROVIDER=creem
CREEM_ENV=live
API_PROD_KEY=replace-with-creem-live-api-key
API_TEST_KEY=
CREEM_WEBHOOK_SECRET=
HERMES_POSTGRES_HOST=127.0.0.1
HERMES_POSTGRES_DB=hermes_app
HERMES_POSTGRES_USER=hermes_app
HERMES_POSTGRES_PASSWORD=replace-with-app-db-password
HERMES_POSTGRES_PORT=5432
HERMES_POSTGRES_ALLOWED_CIDR=0.0.0.0/0
PAY_CLIENT_ID=
PAY_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=
